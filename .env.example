# Copy to .env and fill in. Keep .env private: it contains your Bandcamp login.
# Used both when you run bandcamp_download.py directly and by Docker.

# ---- Your Bandcamp collection and login (needed either way) ----

# Your collection page: https://bandcamp.com/<your Bandcamp username>
BANDCAMP_COLLECTION_URL=https://bandcamp.com/your-username

# Your Bandcamp `identity` cookie (see README). Keep the single quotes.
# Easiest: run `python3 bandcamp_download.py --set-identity`, which fills this in.
BANDCAMP_IDENTITY='paste-cookie-value-here'

# ---- Running the script directly (ignored by Docker) ----

# Music folder that --sync and --fix-names use when you don't pass --dest.
BANDCAMP_SYNC_DEST=/path/to/music/STS9

# ---- Notifications (optional, either way) ----

# Push notifications via ntfy (free app for iPhone/Android: https://ntfy.sh).
# Pick a long random topic name: anyone who knows it can read the messages.
# Sent for every show that downloads and at the end of every --sync (Docker or
# running the script directly), and with Docker also when the login cookie
# expires or a sync fails.
# Leave empty to turn notifications off.
NOTIFY_URL=
# Set to false to skip the per-show "new show" notifications.
NOTIFY_DOWNLOADS=true
# Set to false to skip the "sync done" summary after every sync.
NOTIFY_SYNC=true

# ---- Docker only ----

# Folder on the Docker host that holds the show folders (appears as /music inside).
MUSIC_DIR=/path/to/music/STS9

# Folder on the Docker host for temporary zips while each show downloads.
# Needs ~2x one show's size free (a few GB) and must be writable by PUID.
# Relative paths are relative to this folder; ./tmp is included.
TEMP_DIR=./tmp

# Folder on the Docker host for the sync log (sync.log). Must exist and be writable
# by PUID; ./logs is included.
LOGS_DIR=./logs

# When to sync each day (24h clock) and in which time zone, e.g. Europe/London.
SYNC_TIME=04:00
# Or sync repeatedly instead of once a day, e.g. 1h (on every hour), 30m, 6h.
# When set, SYNC_TIME is ignored. Leave empty for once a day.
SYNC_EVERY=
TZ=UTC

# Also sync right away when the container starts (true/false).
RUN_ON_START=false

# Your user and group ids on the Docker host (`id -u`, `id -g`), so files aren't owned by root.
PUID=1000
PGID=1000

# Extra options for the sync, e.g. --format mp3-320 or --band all
SYNC_ARGS=
