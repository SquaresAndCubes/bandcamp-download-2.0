# Only the project files are tracked; everything else is ignored by default,
# so downloaded shows, temp files and logs can never be committed by accident.
*
!.gitignore
!.dockerignore
!.env.example
!README.md
!Dockerfile
!docker-compose.yml
!bandcamp_download.py
!scheduler.py
# Keep the (empty) tmp/ folder: docker-compose.yml mounts it as the default TEMP_DIR.
!tmp/
!tmp/.gitkeep
# Same for logs/, the default LOGS_DIR (the log files themselves stay ignored).
!logs/
!logs/.gitkeep

# Private: never commit these (they hold your Bandcamp login cookie).
.env
identity.txt
